# --- Serveur ---
PORT=8787
# Adresse publique de ce serveur (HTTPS obligatoire pour Apple Wallet)
PUBLIC_URL=https://fidelite.example.fr
# Adresse du site vitrine (sert aux liens et au logo Google Wallet)
SITE_URL=https://redahfir.github.io/best-burger
# Origines autorisées à appeler l'API (par défaut : celle de SITE_URL)
# ALLOWED_ORIGINS=https://redahfir.github.io,https://www.bestburger.fr
DATABASE_PATH=./data/fidelite.sqlite
# 1 si le serveur est derrière un proxy (Render, Railway, Fly, nginx…)
TRUST_PROXY=1
# Inscriptions maximum par heure et par adresse IP
# INSCRIPTIONS_PAR_HEURE=30

# --- Règle de fidélité ---
TAMPONS_REQUIS=10
RECOMPENSE=Un menu offert

# --- Comptoir (au moins 12 caractères, à donner uniquement à l'équipe) ---
STAFF_SECRET=

# --- Apple Wallet (compte Apple Developer, 99 $/an) ---
# Chaque valeur peut être le contenu PEM ou le chemin d'un fichier.
APPLE_PASS_TYPE_ID=pass.fr.bestburger.fidelite
APPLE_TEAM_ID=
APPLE_PASS_CERT=./certificats/pass.pem
APPLE_PASS_KEY=./certificats/pass.key
# APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=./certificats/wwdr-g4.pem

# --- Google Wallet (console Google Pay & Wallet, gratuit) ---
GOOGLE_ISSUER_ID=
# Fichier JSON de la clé du compte de service (ou son contenu)
GOOGLE_SERVICE_ACCOUNT=./certificats/google-service-account.json
